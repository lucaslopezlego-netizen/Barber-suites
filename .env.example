# =============================================================================
# Barber Suites · Variables de entorno
# Copia este archivo como .env.local y rellena los valores de tu proyecto
# Supabase (Project Settings → API).
# =============================================================================

# URL del proyecto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave anónima (pública). Solo permite lo que el RLS deja hacer al público.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role (SECRETA). Solo se usa en el servidor para crear reservas
# desde la web. Nunca la expongas en el navegador ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=

# Sal secreta para anonimizar la IP en el rate limit (cualquier texto largo y aleatorio)
RATE_LIMIT_SALT=

# URL pública del sitio (para enlaces y el archivo .ics)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
